+        t_coop, t_hand = text_feats(model, clip_model, classnames, params)   # 最後才算：會覆寫 aux_container 的文字欄位
+    h = lambda t: t.half().cpu().numpy()
+    np.savez(path, q_cls=h(q_cls), q_val=h(q_val), q_plain=h(q_plain),
+             s_cls=h(s_cls), s_val=h(s_val), s_plain=h(s_plain),
+             t_coop=t_coop.cpu().numpy(), t_hand=t_hand.cpu().numpy(),
+             q_logits=output.float().cpu().numpy(),
+             q_y=np.repeat(range(n_way), n_query), s_y=np.repeat(range(n_way), n_support),
+             classes=np.array([int(c) for c in idxs]))
+
