+def extract_feats(model, images, params):
+    """eval + no_grad 下取 CLS、value patch（MaskCLIP 式）、plain patch，皆 L2 normalize：[B, d]、[B, P, d]、[B, P, d]"""
+    enc = model.image_encoder
+    blk = enc.transformer.resblocks[-1]
+    cache = {}
+    h_in = blk.register_forward_pre_hook(lambda m, a: cache.__setitem__("in", a[0]))
+    h_out = blk.register_forward_hook(lambda m, a, o: cache.__setitem__("out", o))
+    try:
+        with torch.amp.autocast(device_type="cuda", dtype=torch.float16):
+            cls = enc(images, params)
+            val = blk.attn.proj(blk.attn.v_proj(blk.ln_1(cache["in"][1:])))
+            val = enc.ln_post(val) @ enc.proj
+            plain = enc.ln_post(cache["out"][1:]) @ enc.proj
+    finally:
+        h_in.remove(); h_out.remove()
+    norm = lambda t: F.normalize(t.float(), dim=-1)
+    return norm(cls), norm(val.permute(1, 0, 2)), norm(plain.permute(1, 0, 2))
+
+
+def text_feats(model, clip_model, classnames, params):
+    """CoOp 學到的 prompt 與固定 prompt「a photo of a {name}.」經訓練後文字編碼器的特徵，皆 L2 normalize"""
+    with torch.amp.autocast(device_type="cuda", dtype=torch.float16):
+        t_coop = model.text_encoder(model.prompt_learner(), model.tokenized_prompts, params=params)
+        tok = torch.cat([clip.tokenize("a photo of a %s." % n.replace("_", " ")) for n in classnames])
+        emb_layer = clip_model.token_embedding           # 不屬於 CustomCLIP，仍在 CPU
+        emb = emb_layer(tok.to(emb_layer.weight.device)).type(torch.float16).cuda()
+        t_hand = model.text_encoder(emb, tok, params=params)
+    return F.normalize(t_coop.float(), dim=-1), F.normalize(t_hand.float(), dim=-1)
+
+
+def dump_episode(path, model, clip_model, params, x_query, x_support, classnames, idxs, output, n_way, n_query, n_support):
+    with torch.no_grad():
+        q_cls, q_val, q_plain = extract_feats(model, x_query.cuda(), params)
