         self.text_encoder = TextEncoder(clip_model, params)
         self.logit_scale = clip_model.logit_scale
         self.dtype = clip_model.dtype
+        self.local = getattr(params, "local", False)
+        if self.local:
+            self._last_in = None
+            def _grab(module, inputs):
+                self._last_in = inputs[0]          # 最後一個 visual block 的輸入 [L, B, W]
+            self.image_encoder.transformer.resblocks[-1].register_forward_pre_hook(_grab)
+
+    def value_patches(self):
+        """MaskCLIP 式 value patch：最後一層只取 value → out_proj，不經 attention 混合、殘差與 MLP"""
+        blk = self.image_encoder.transformer.resblocks[-1]
+        # forward 的 logits 在 autocast 區塊外計算，這裡自己包 autocast，與 CLS 路徑的精度一致
+        with torch.amp.autocast(device_type="cuda", dtype=torch.float16):
+            h = blk.ln_1(self._last_in[1:])            # [P, B, W]
+            v = blk.attn.proj(blk.attn.v_proj(h))
+            v = self.image_encoder.ln_post(v) @ self.image_encoder.proj
+        return F.normalize(v.permute(1, 0, 2).float(), dim=-1)   # [B, P, d]
 
 
